# -----------------------------------------------------------------------
# This file is the deploy-time environment, read once when the container
# starts (see docker-entrypoint.sh) — it is NOT live-reloaded while the
# container is running, and (with config caching enabled) Laravel doesn't
# re-read it again until the next container start.
#
# Mail (SMTP) settings are the one exception to "this file is the
# config": once an admin configures mail through the hub's Settings page
# in the browser, those values are saved to the database and take over
# completely, overriding whatever is set below on every request, from
# then on — no restart needed for changes made there. The MAIL_* lines
# below only matter before SMTP has ever been configured through the UI;
# after that they're dead and safe to ignore. See each MAIL_* line's own
# comment, and App\Providers\AppServiceProvider::applySmtpSettingsFromDatabase()
# in the app source for the mechanics.
# -----------------------------------------------------------------------

APP_NAME=LANHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# Deliberately outside database/ — that directory ships with the app
# image itself (including database/migrations/); a persistent volume
# mounted there instead would hide the image's own migrations folder on
# every update. Mount your persistent volume at storage/db instead (see
# docker-compose.yml) and leave database/ alone.
DB_DATABASE=/var/www/html/storage/db/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Pre-setup fallback only ("log" = write mail to the log instead of
# sending it). UI-configurable — once SMTP is set up on the Settings
# page, that value wins instead and this is ignored. Don't edit this to
# change mail behavior post-setup; use the UI.
MAIL_MAILER=log
# UI-configurable (Settings page "Encryption") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_SCHEME=null
# UI-configurable (Settings page "SMTP Host") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_HOST=127.0.0.1
# UI-configurable (Settings page "SMTP Port") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_PORT=2525
# UI-configurable (Settings page "SMTP Username") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_USERNAME=null
# UI-configurable (Settings page "SMTP Password") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_PASSWORD=null
# UI-configurable (Settings page "From Address") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_FROM_ADDRESS="hello@example.com"
# UI-configurable (Settings page "From Name") — ignored once SMTP is
# configured there. Don't edit this to change mail behavior post-setup.
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
